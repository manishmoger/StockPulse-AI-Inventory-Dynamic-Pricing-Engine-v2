# StockPulse — Environment Configuration

# ── Zycus LiteLLM Gateway (Hackathon default — already configured in application.properties) ──
AI_PROVIDER=zycus
AI_API_KEY=sk_your_zycus_or_openai_compatible_key_here
AI_MODEL=qwen-cursor
AI_BASE_URL=https://litellm-qc.zycus.net/v1/chat/completions
AI_PRODUCT_HEADER=PC1
AI_TIMEOUT_SECONDS=30

# ── Alternative: Groq (free tier) ────────────────────────────────────────────
# AI_PROVIDER=groq
# AI_API_KEY=gsk_your_groq_key_here
# AI_MODEL=llama3-8b-8192
# AI_BASE_URL=https://api.groq.com/openai/v1/chat/completions

# ── Alternative: Gemini ───────────────────────────────────────────────────────
# AI_PROVIDER=gemini
# AI_API_KEY=AIza_your_gemini_key_here
# AI_MODEL=gemini-1.5-flash

# ── Demand Spike Detection ────────────────────────────────────────────────────
DEMAND_SPIKE_MULTIPLIER=3.0
